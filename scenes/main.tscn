[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/test_terrain.gd" id="2_terrain"]
[ext_resource type="PackedScene" path="res://scenes/car.tscn" id="3_car"]
[ext_resource type="Script" path="res://scripts/orbit_camera.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/debug_hud.gd" id="5_hud"]
[ext_resource type="Shader" path="res://shaders/sky.gdshader" id="6_sky"]
[ext_resource type="Script" path="res://scripts/atmosphere.gd" id="7_atmosphere"]
[ext_resource type="Script" path="res://scripts/settings_menu.gd" id="8_menu"]

[sub_resource type="ShaderMaterial" id="SkyMat"]
shader = ExtResource("6_sky")

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("SkyMat")
process_mode = 3
radiance_size = 3

[sub_resource type="Environment" id="Env_main"]
background_mode = 2
sky = SubResource("Sky_main")
ambient_light_source = 3
ambient_light_sky_contribution = 0.8
reflected_light_source = 2
tonemap_mode = 3
ssao_enabled = true
glow_enabled = true
fog_enabled = true
fog_density = 0.0015
fog_sun_scatter = 0.2
fog_aerial_perspective = 0.6
fog_height = 4.0

[sub_resource type="SphereShape3D" id="SphereShape3D_arm"]
radius = 0.3

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_main")

[node name="Sun" type="DirectionalLight3D" parent="."]
light_energy = 1.1
shadow_enabled = true
directional_shadow_max_distance = 150.0

[node name="Moon" type="DirectionalLight3D" parent="."]
light_color = Color(0.62, 0.72, 1, 1)
light_energy = 0.0
shadow_enabled = true
directional_shadow_max_distance = 120.0
visible = false

[node name="TestTerrain" type="StaticBody3D" parent="."]
script = ExtResource("2_terrain")

[node name="Car" parent="." instance=ExtResource("3_car")]

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("4_camera")
target_path = NodePath("../Car")

[node name="SpringArm3D" type="SpringArm3D" parent="CameraRig"]
shape = SubResource("SphereShape3D_arm")
spring_length = 7.5
margin = 0.2

[node name="Camera3D" type="Camera3D" parent="CameraRig/SpringArm3D"]
current = true
fov = 65.0
far = 3000.0

[node name="Atmosphere" type="Node" parent="."]
script = ExtResource("7_atmosphere")
environment_path = NodePath("../WorldEnvironment")
sun_path = NodePath("../Sun")
moon_path = NodePath("../Moon")
car_path = NodePath("../Car")

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("5_hud")
car_path = NodePath("../Car")

[node name="Menu" type="CanvasLayer" parent="."]
script = ExtResource("8_menu")
atmosphere_path = NodePath("../Atmosphere")
